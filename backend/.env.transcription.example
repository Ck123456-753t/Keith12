# Example only. Supply real credentials through deployment secrets.
# These may override the shared DARAJA_* values. If left unset in the
# deployment environment, the shared Daraja settings are used. An explicit
# TRANSCRIPTION_DARAJA_ENABLED=false keeps transcription payments disabled.
TRANSCRIPTION_DARAJA_ENV=sandbox
TRANSCRIPTION_DARAJA_ENABLED=false
TRANSCRIPTION_DARAJA_CALLBACK_URL=https://primetask-workspace.onrender.com/api/payments/daraja/callback/stk
TRANSCRIPTION_DARAJA_CONSUMER_KEY=
TRANSCRIPTION_DARAJA_CONSUMER_SECRET=
TRANSCRIPTION_DARAJA_SHORTCODE=
TRANSCRIPTION_DARAJA_PASSKEY=
TRANSCRIPTION_DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Required only when TRANSCRIPTION_DARAJA_TRANSACTION_TYPE=CustomerBuyGoodsOnline.
TRANSCRIPTION_DARAJA_TILL_NUMBER=
