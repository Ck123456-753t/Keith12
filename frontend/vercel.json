{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://primetask-gvfr.onrender.com/api/:path*"
    },
    {
      "source": "/auth/register/:username",
      "destination": "/auth/register"
    },
    {
      "source": "/register/:username",
      "destination": "/auth/register"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "cleanUrls": true
}
